# Python environment and caches
.venv/
.venv-voice/
__pycache__/
*.pyc

# Big media stays OUT of git (it would bloat the repo fast).
# Your originals live on your disk; back them up separately (external drive / cloud folder).
# Scripts, configs, script.md, shotlists and reports ARE tracked so we can roll back.
inbox/*
!inbox/.gitkeep
projects/*/voiceover/*
projects/*/images/*
projects/*/clips/*
projects/*/dialogue/*
projects/*/build/*
projects/*/output/*.mp4
projects/*/output/*.wav
projects/*/output/*.png
projects/*/output/*.jpg
!projects/*/*/.gitkeep
assets/music/*
assets/sfx/*
assets/fonts/*
assets/branding/*
!assets/*/.gitkeep
voices/**/*.wav
voices/**/*.mp3
voices/**/*.m4a
voices/**/*.aac
voices/**/*.ogg
voices/**/*.flac
voices/**/*.webm

# Downloaded AI models
models/

# OS junk
.DS_Store
Thumbs.db
